# ⒸAngelaMos | 2025
# Production Vite Dockerfile (Multi-stage build)
# Stage 1: Build the React app with Vite
# Stage 2: Serve static files with Nginx


# Stage 1: Build
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@10.34.5 --activate

WORKDIR /app

# Copy package files
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml frontend/.npmrc ./

# Install all dependencies required by TypeScript and Vite during the build
RUN pnpm install --frozen-lockfile

# Copy source code
COPY frontend/ .

# Build the app (creates dist/ folder with static files)
RUN pnpm build



# Stage 2: Serve with Nginx
FROM nginx:alpine

# Copy built static files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configurations
COPY conf/nginx/prod.nginx /etc/nginx/nginx.conf
COPY conf/nginx/http.conf /etc/nginx/http.conf

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
